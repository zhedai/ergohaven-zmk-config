#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        cmb_caps {
            bindings = <&kp CAPS>;
            key-positions = <36 57>;
            layers = <0 1>;
            timeout-ms = <100>;
        };
    };

    macros {
        sc_lang_en: sc_lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "SC_LANG_EN";
        };

        sc_lang_ru: sc_lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "SC_LANG_RU";
        };

        sc_lang_ga: sc_lang_ga {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N3))>;
            label = "SC_LANG_GA";
        };

        sc_notif_en: sc_notif_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F24>;
            label = "SC_NOTIF_EN";
        };

        sc_notif_ru: sc_notif_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F23>;
            label = "SC_NOTIF_RU";
        };

        sc_notif_games: sc_notif_games {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F22>;
            label = "SC_NOTIF_GAMES";
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0 &sc_lang_en>,
                <&macro_wait_time 30>,
                <&sc_notif_en>;

            label = "LAYER_EN";
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 1 &sc_lang_ru>,
                <&macro_wait_time 30>,
                <&sc_notif_ru>;

            label = "LAYER_RU";
        };

        layer_games: layer_games {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 9 &sc_lang_en>,
                <&sc_lang_ga>,
                <&macro_wait_time 30>,
                <&sc_notif_games>;

            label = "LAYER_GAMES";
        };

        mo_en_ru: mo_en_ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&sc_lang_en>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&sc_lang_ru>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "MO_EN_RU";
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 500>, <&layer_en>;

            label = "BT_0";
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 500>, <&layer_en>;

            label = "BT_1";
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 500>, <&layer_en>;

            label = "BT_2";
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&macro_wait_time 500>, <&layer_en>;

            label = "BT_3";
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&macro_wait_time 500>, <&layer_en>;

            label = "BT_4";
        };

        sym_triple_quotes: sym_triple_quotes {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LS(ENTER) &kp LS(ENTER) &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp UP>;
            label = "SYM_TRIPLE_QUOTES";
        };

        sym_lb: sym_lb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SYM_LB";
        };

        sym_rb: sym_rb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SYM_RB";
        };

        sym_code: sym_code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp C &kp O &kp D &kp E &kp RIGHT_BRACE &kp LS(ENTER) &kp LS(ENTER) &kp LEFT_BRACE &kp C &kp O &kp D &kp E &kp RIGHT_BRACE &kp UP>;
            label = "SYM_CODE";
        };

        sym_quote: sym_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp Q &kp U &kp O &kp T &kp E &kp RIGHT_BRACE &kp LS(ENTER) &kp LS(ENTER) &kp LEFT_BRACE &kp Q &kp U &kp O &kp T &kp E &kp RIGHT_BRACE &kp UP>;
            label = "SYM_QUOTE";
        };
    };

    behaviors {
        beh_triple_quotes: beh_triple_quotes {
            compatible = "zmk,behavior-hold-tap";
            label = "BEH_TRIPLE_QUOTES";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            bindings = <&sym_triple_quotes>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                 &kp N6  &kp N7           &kp N8         &kp N9      &kp N0     &none
&none      &kp Q   &kp W     &kp E     &kp R      &kp T                                  &kp Y   &kp U            &kp I          &kp O       &none      &none
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                  &kp H   &kp J            &kp K          &kp L       &kp P      &none
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B   &layer_ru    &kp C_PLAY_PAUSE  &kp N   &kp M            &none          &none       &kp COMMA  &kp DOT
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo 2   &kp SPACE    &kp ENTER         &mo 5   &kp RIGHT_SHIFT  &kp BACKSPACE  &kp DELETE
            >;

            display-name = "En";
            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC             &kp N1                   &kp N2                &kp N3              &kp N4              &kp N5                                             &kp N6              &kp N7                                           &kp N8               &kp N9                 &kp N0               &none
&kp RU_CYRILLIC_IO  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                                 &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE                              &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&kp TAB             &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                                 &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O                                &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LSHFT           &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &layer_en    &kp C_PLAY_PAUSE  &kp RU_CYRILLIC_TE  &mt RU_CYRILLIC_HARD_SIGN RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_COMMA         &kp RU_DOT
                                             &kp LGUI              &kp LALT            &kp LCTRL           &mo_en_ru 2         &kp SPACE    &kp ENTER         &mo_en_ru 5         &kp RIGHT_SHIFT                                  &kp BACKSPACE        &kp DELETE
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav {
            bindings = <
&kp F1           &kp F2      &kp F3        &kp F4    &kp F5         &kp F6                                  &kp F7     &kp F8          &kp F9     &kp F10       &kp F11       &kp F12
&kp PRINTSCREEN  &kp INSERT  &kp HOME      &kp UP    &kp END        &kp PG_UP                               &none      &kp LC(X)       &kp LC(C)  &kp LC(V)     &none         &none
&kp TAB          &none       &kp LEFT      &kp DOWN  &kp RIGHT      &kp PAGE_DOWN                           &kp K_APP  &sk LEFT_SHIFT  &sk LCTRL  &sk LEFT_ALT  &kp LEFT_GUI  &none
&caps_word       &none       &kp LC(LEFT)  &none     &kp LC(RIGHT)  &mo 4          &layer_games    &kp F13  &mo 3      &kp LC(Z)       &none      &kp LC(Y)     &none         &none
                             &trans        &trans    &trans         &trans         &trans          &trans   &mo 6      &trans          &trans     &trans
            >;

            display-name = "Navigation";
            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        mouse {
            bindings = <
&none  &none  &none           &none           &none            &none                             &trans  &trans  &trans  &trans  &trans  &trans
&none  &none  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP                      &trans  &trans  &trans  &trans  &trans  &trans
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                    &trans  &trans  &trans  &trans  &trans  &trans
&none  &none  &mkp LCLK       &mkp MCLK       &mkp RCLK        &none           &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
              &trans          &trans          &trans           &trans          &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "Mouse";
        };

        num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &none      &none      &none      &none      &kp LPAR         &kp RPAR
&trans  &trans  &trans  &trans  &trans  &trans                    &none      &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans  &trans  &trans  &trans  &trans  &trans                    &none      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS      &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp COMMA        &kp DOT
                &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &trans     &trans
            >;

            label = "Numpad";
        };

        sym {
            display-name = "Symbols";
            bindings = <
&none      &none                           &kp AT    &kp HASH   &kp DLLR  &none                        &none                       &sym_lb   &kp CARET  &sym_rb   &none      &none
&kp TILDE  &beh_triple_quotes GRAVE GRAVE  &kp LT    &kp EQUAL  &kp GT    &kp SQT                      &beh_triple_quotes DQT DQT  &kp LBKT  &kp UNDER  &kp RBKT  &sym_code  &sym_quote
&none      &kp BSLH                        &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT                   &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL   &kp QUESTION
&none      &none                           &kp STAR  &kp COLON  &kp FSLH  &none     &none     &kp F13  &none                       &kp PIPE  &kp TILDE  &kp AMPS  &kp COMMA  &kp DOT
                                           &trans    &trans     &trans    &mo 6     &trans    &trans   &trans                      &trans    &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        sys {
            bindings = <
&none  &layer_en  &layer_ru  &layer_games  &out OUT_USB  &out OUT_BLE                    &bt_0   &bt_1           &bt_2      &bt_3         &bt_4         &bt BT_CLR_ALL
&none  &kp F1     &kp F2     &kp F3        &kp F4        &none                           &none   &none           &none      &none         &none         &studio_unlock
&none  &kp F5     &kp F6     &kp F7        &kp F8        &none                           &none   &sk LEFT_SHIFT  &sk LCTRL  &sk LEFT_ALT  &kp LEFT_GUI  &none
&none  &kp F9     &kp F10    &kp F11       &kp F12       &none         &trans    &trans  &none   &none           &none      &none         &none         &none
                  &trans     &trans        &trans        &trans        &trans    &trans  &trans  &trans          &trans     &trans
            >;

            display-name = "System";
        };

        notif_en {
            bindings = <
&sc_notif_en  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        notif_ru {
            bindings = <
&sc_notif_ru  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        gam {
            label = "Games";
            bindings = <
&trans  &trans          &trans  &trans  &trans  &trans                                 &trans  &trans  &trans  &trans  &trans  &trans
&kp T   &kp TAB         &kp Q   &kp W   &kp E   &kp R                                  &trans  &trans  &trans  &trans  &trans  &trans
&kp G   &kp LEFT_SHIFT  &kp A   &kp S   &kp D   &kp F                                  &trans  &trans  &trans  &trans  &trans  &trans
&kp B   &kp LCTRL       &kp Z   &kp X   &kp C   &kp V   &layer_en    &kp C_PLAY_PAUSE  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &mo 10  &trans       &trans            &mo 11  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gam_fun {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp F13  &trans  &trans  &trans  &trans   &trans   &trans
                &trans  &trans  &trans  &trans  &trans    &trans   &mo 12  &trans  &trans  &trans
            >;

            label = "Games Functions";
            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        gam_sym {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &kp GRAVE  &kp MINUS  &kp EQUAL  &none     &none  &none
&trans  &trans  &trans  &trans  &trans  &trans                     &none      &kp LBKT   &kp RBKT   &none     &none  &none
&trans  &trans  &trans  &trans  &trans  &trans                     &none      &kp SEMI   &kp APOS   &kp BSLH  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp F13  &none      &kp COMMA  &kp DOT    &kp FSLH  &none  &none
                &trans  &trans  &trans  &mo 12  &trans    &trans   &trans     &trans     &trans     &trans
            >;

            label = "Games Symbols";
            sensor-bindings =
                <&inc_dec_kp LEFT_SHIFT LCTRL>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        gam_sys {
            bindings = <
&sc_notif_games  &layer_en  &layer_ru  &layer_games  &none   &none                    &none  &none   &none   &none   &none  &none
&none            &none      &none      &none         &none   &none                    &none  &none   &none   &none   &none  &none
&none            &none      &none      &none         &none   &none                    &none  &none   &none   &none   &none  &none
&none            &none      &none      &none         &none   &none  &trans    &trans  &none  &none   &none   &none   &none  &none
                            &trans     &trans        &trans  &none  &trans    &trans  &none  &trans  &trans  &trans
            >;

            label = "Games System";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        cond_notif_en {
            if-layers = <0 6>;
            then-layer = <7>;
        };

        cond_notif_ru {
            if-layers = <1 6>;
            then-layer = <8>;
        };
    };
};
